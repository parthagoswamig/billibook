# 1. Enter your Supabase Project URL (Dashboard -> Settings -> API -> Project URL)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Enter your Supabase Anon Key (Dashboard -> Settings -> API -> anon / public key)
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
